[Unit]
Description=Scratch Card Auth Service
After=network.target

[Service]
Type=simple
User=scratchauth
Group=scratchauth
WorkingDirectory=/opt/scratch-auth
ExecStart=/usr/bin/node /opt/scratch-auth/server.mjs
Restart=always
RestartSec=2
Environment=NODE_ENV=production
Environment=AUTH_PORT=3901
Environment=AUTH_HOST=127.0.0.1
Environment=USERS_FILE=/var/lib/scratch-auth/users.json
Environment=GAME_FILE=/var/www/escape-the-room/scratch/index.html
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/scratch-auth
ReadOnlyPaths=/var/www/escape-the-room/scratch/index.html
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
